{
  "name": "use-reducer-devtools",
  "version": "0.1.0",
  "keywords": [
    "devtools",
    "hook",
    "react",
    "reducer",
    "redux",
    "use-reducer"
  ],
  "license": "MIT",
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "prepare": "vp config",
    "prebuild": "vp run type",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "format": "vp fmt",
    "attw": "vpx scripts/attw.ts",
    "publint": "publint",
    "type": "tsc",
    "prepack": "vp run publint",
    "example": "vp -C examples/example-app dev"
  },
  "dependencies": {
    "@redux-devtools/extension": "^4.0.0",
    "@redux-devtools/utils": "^4.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@redux-devtools/instrument": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
